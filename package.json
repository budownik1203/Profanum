{
  "name": "profanum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Profanum - nekromanta kontra miasto i Kościół. Roguelike bullet hell w PixiJS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "artifact": "node tools/build-artifact.mjs dist/profanum.html",
    "shots": "node tools/shot.mjs dist/profanum.html dist/shots tools/scenarios/tour.mjs"
  },
  "dependencies": {
    "pixi.js": "8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
